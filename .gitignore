# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tesseract.js downloaded language models
*.traineddata

.vercel

# 새김AI Atelier — 작품 원본과 DB는 내 PC에만 둔다
/local-api/data/*
!/local-api/data/.gitkeep
/local-api/media/*
!/local-api/media/.gitkeep

# Cloudflare Tunnel 자격증명
/tunnel/*.json
