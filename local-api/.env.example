# 이 파일을 .env 로 복사해서 쓰십시오. (.env 는 깃에 올라가지 않습니다)

# 서버가 들을 주소와 포트. 127.0.0.1 이면 이 컴퓨터 안에서만 열립니다.
# 바깥으로는 Cloudflare Tunnel 이 이어 주므로 0.0.0.0 으로 바꿀 필요가 없습니다.
ATELIER_HOST=127.0.0.1
ATELIER_PORT=8787

# 브라우저에서 직접 부를 수 있는 주소 목록 (쉼표로 구분)
ATELIER_ALLOWED_ORIGINS=https://saegimai.com,https://www.saegimai.com,http://localhost:3000

# ComfyUI 출력 폴더 — ingest.mjs 가 여기를 훑습니다.
ATELIER_SOURCE=F:/0.SoulmaruAI/1.aiimage/ComfyUI/output

# 개인 만들기 콘솔(8788) 로그인. 실제 비밀번호는 .env 에만 두십시오.
ATELIER_STUDIO_USER=okmceo@gmail.com
ATELIER_STUDIO_PASSWORD=<길고-무작위인-비밀번호>

# 저장 위치를 옮기고 싶을 때만 건드리십시오.
# ATELIER_DB=F:/0.SoulmaruAI/1.aiimage/atelier/local-api/data/atelier.db
# ATELIER_MEDIA=F:/0.SoulmaruAI/1.aiimage/atelier/local-api/media

# 배포 오케스트레이터 (만들기 콘솔 /distribution)
# 키가 있으면 콘솔에서 바로 패키지·리뷰를 만듭니다.
# 비워 두면 "지시문 복사 → Claude 에 붙여넣기 → 결과 붙여넣기" 방식으로 씁니다.
# ANTHROPIC_API_KEY=
# DIST_MODEL=claude-opus-5-5
